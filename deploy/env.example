# HA Gatekeeper - settings reference for docker-compose.yml
#
# `sudo ./install.sh` creates and maintains .env for you (mode 600) and walks you through
# every value. Copy this file to .env only if you prefer to configure things by hand, then
# run:  docker compose up -d --build
#
# QUOTING: wrap every value in double quotes. Inside the quotes write  \\  for a backslash,
# \"  for a double quote and  \$  for a dollar sign. Never commit .env: it holds secrets.

# ---- REQUIRED -----------------------------------------------------------------------------
# Home Assistant as reachable from THIS server (not from your laptop). A VPS cannot see
# 192.168.x.x or *.local addresses unless a VPN (Tailscale/WireGuard) links the networks.
HA_BASE_URL="https://your-instance.ui.nabu.casa"
# Long-lived access token: Home Assistant > your profile > Security > Long-lived access tokens.
HA_TOKEN=""
# Admin dashboard password. At least 8 characters; 12+ strongly recommended.
ADMIN_PASSWORD=""
# Base64, 32+ bytes:                      openssl rand -base64 32
ADMIN_SESSION_SECRET=""
# Secret that hashes issued API tokens. CHANGING OR LOSING IT INVALIDATES EVERY TOKEN.
#                                        openssl rand -base64 48 | tr '+/' '-_' | tr -d '='
API_KEY_HASH_SECRET=""

# ---- Public address / HTTPS ---------------------------------------------------------------
# Public URL users and agents use (also the allowed CORS origin).
CORS_ORIGIN="http://localhost:8080"
# "proxy" starts the bundled Caddy HTTPS reverse proxy (needs deploy/caddy/Caddyfile, which
# install.sh generates). Leave unset for private/SSH-tunnel use.
# COMPOSE_PROFILES="proxy"
# Set to 1 only when Caddy (or another proxy that overwrites X-Forwarded-For) is in front, so
# audit logs and the login rate limit see real client IPs.
TRUST_PROXY=""
# Host address/port the app listens on. Keep 127.0.0.1: Docker bypasses the firewall for
# published ports, and admin login needs HTTPS.
GATEKEEPER_BIND="127.0.0.1"
GATEKEEPER_PORT="8080"

# ---- Optional -----------------------------------------------------------------------------
GATEKEEPER_DATA_DIR="./data"          # SQLite database; must be writable by uid 1001
AUDIT_LOG_RETENTION_DAYS="90"         # 0 keeps everything
# Starting values for how the server protects Home Assistant. The administrator can change them in the
# dashboard (Settings), and a value saved there wins. See docs/HOME_ASSISTANT_CONNECTION.md.
# HA_STATE_CACHE_MS="2000"              # how long an answer fetched from Home Assistant is reused (0 = off)
# HA_MAX_CONCURRENCY="8"                # most requests in flight to Home Assistant at once
LOG_LEVEL="info"
# Container path of a CA certificate (PEM) for a private Home Assistant certificate. Put the
# file in deploy/certs/ and reference it as /certs/<file>.
HA_CA_CERT=""
# The secrets above stay in this file (mode 600). install.sh copies each into ./secrets/<name>
# (root-only directory) and the container reads those files; they are never container env vars.
# Written by install.sh, read by the watchdog:
ALERT_WEBHOOK_URL=""                  # Slack/Discord/Mattermost/generic webhook for down/recovered alerts
ADMIN_ALLOWED_IPS=""                  # restrict /admin/* to these IPs/CIDRs (proxy modes only)
# COMPOSE_FILE="docker-compose.yml:deploy/compose.host-access.yml"   # Home Assistant on this same server
